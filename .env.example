# Copy to .env.local for local work. On Cloudflare, add the same two as build variables
# (Workers & Pages > gulfelitetransport > Settings > Variables and Secrets > Build).
# Use the public anon key only. Never the service_role key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
